PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=borrowbox_db
SESSION_SECRET=

# Local demo accounts (required — server will not start without passwords set).
ADMIN_EMAIL=admin@borrowbox.local
ADMIN_PASSWORD=
DEMO_LENDER_EMAIL=sample.lender@borrowbox.local
DEMO_LENDER_PASSWORD=
DEMO_BORROWER_EMAIL=sample.borrower@borrowbox.local
DEMO_BORROWER_PASSWORD=

# Add your Google OAuth credentials here in a local .env file, not in this template.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
GOOGLE_TIME_ZONE=Asia/Manila
TOKEN_ENCRYPTION_KEY=
